# ============================================
# Z-API  (painel: https://app.z-api.io)
# ============================================
# URL base da API (normalmente nao muda)
ZAPI_BASE_URL=https://api.z-api.io
# ID da sua instancia (pega em: Instancias > sua instancia)
ZAPI_INSTANCE_ID=cole-aqui-o-id-da-instancia
# Token da instancia (na mesma tela da instancia)
ZAPI_INSTANCE_TOKEN=cole-aqui-o-token-da-instancia
# Client-Token da CONTA (Seguranca > Token de seguranca da conta)
# A Z-API exige esse header em toda chamada
ZAPI_CLIENT_TOKEN=cole-aqui-o-client-token-da-conta

# ============================================
# Supabase  (painel: https://supabase.com/dashboard > seu projeto > Settings > API)
# ============================================
SUPABASE_URL=https://bldlhcpghqueklouvtxe.supabase.co
# Use a chave "service_role" (secreta! nunca commitar) — o bot roda no servidor
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key

# ============================================
# Bot
# ============================================
# Seu WhatsApp pessoal, com DDI, so numeros (ex: 5511999998888)
# E pra onde vao as notificacoes de escalonamento
OWNER_PHONE=5511999998888
# Porta do servidor (Railway/Render definem PORT sozinhos, pode deixar assim)
PORT=3000
# true = bot tambem responde em grupos | false = so no privado (recomendado)
REPLY_IN_GROUPS=false
