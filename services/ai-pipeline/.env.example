# Supabase (Dashboard → Settings → API / Database)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Connection string do Postgres (pooler em produção): postgresql://...
DATABASE_URL=
# Segredo JWT (projetos legados HS256). Deixe vazio para usar o JWKS do projeto.
SUPABASE_JWT_SECRET=

# Análise multimodal (evidências visuais)
ANTHROPIC_API_KEY=

# OCR (Google Cloud Vision — API key com Vision habilitada)
GOOGLE_VISION_API_KEY=

# Worker
WORKER_ENABLED=true
WORKER_POLL_SECONDS=2
