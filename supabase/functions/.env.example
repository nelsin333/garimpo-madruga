# Secrets das Edge Functions.
#
# Publicar com: supabase secrets set --env-file supabase/functions/.env
# Nada aqui vai para o app: o bundle só recebe variáveis EXPO_PUBLIC_*.
#
# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY são injetadas
# automaticamente pela plataforma — não declare aqui.

# ---------- Conteúdo (Sprint 5) ----------
# Geração de título/descrição do anúncio. Sem a chave, o fallback
# determinístico continua funcionando.
ANTHROPIC_API_KEY=

# ---------- Pagamento — Mercado Pago (Sprint 6) ----------
# Credenciais → https://www.mercadopago.com.br/developers/panel/app
# Sem MERCADOPAGO_ACCESS_TOKEN, create-payment responde 503 e nenhum pedido é
# marcado como pago.
MERCADOPAGO_ACCESS_TOKEN=
# Secret do webhook (painel → Webhooks → "Assinatura secreta"). Sem ele o
# payments-webhook recusa todo evento: sem assinatura não há como distinguir
# uma notificação real de uma forjada.
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública da função payments-webhook, enviada ao provedor como
# notification_url. Ex.: https://<projeto>.supabase.co/functions/v1/payments-webhook
MERCADOPAGO_WEBHOOK_URL=

# ---------- Frete — Melhor Envio (Sprint 6) ----------
# Token OAuth da aplicação → https://melhorenvio.com.br/painel/gerenciar/tokens
MELHORENVIO_TOKEN=
# Token compartilhado configurado no webhook do painel; chega em
# x-melhorenvio-token. Sem ele o shipping-webhook recusa todo evento.
MELHORENVIO_WEBHOOK_SECRET=
# 1 usa o ambiente de homologação (sandbox.melhorenvio.com.br).
MELHORENVIO_SANDBOX=
# A API exige User-Agent identificando a aplicação e um e-mail de contato.
MELHORENVIO_USER_AGENT=

# ---------- Custódia ----------
# Token do agendamento que conclui pedidos entregues cujo prazo de custódia
# venceu: POST /confirm-delivery?mode=escrow com header x-escrow-token.
ESCROW_CRON_TOKEN=
